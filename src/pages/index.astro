---
import BaseLayout from '../layouts/BaseLayout.astro'
import App from '../app/App'
import { faqs } from '../app/components/FAQSection'

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: '株式会社Vecta',
  url: 'https://www.vecta.co.jp/',
  logo: 'https://swarrow.com/logo.png',
}

const productSchema = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: 'SwarrowCall',
  description:
    'AIが電話・チャット・LINEの問い合わせに24時間365日自動応答するカスタマーサポートサービス。RAGによるナレッジベース連携、AI自動架電機能を搭載。',
  brand: {
    '@type': 'Organization',
    name: '株式会社Vecta',
  },
  offers: {
    '@type': 'Offer',
    availability: 'https://schema.org/InStock',
    priceCurrency: 'JPY',
  },
}

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: faq.answer,
    },
  })),
}
---

<BaseLayout
  title="AI電話自動応答・チャットボット | SwarrowCall（スワローコール）"
  description="SwarrowCallは、AIが電話・チャット・LINEの問い合わせに24時間365日自動応答するカスタマーサポートサービスです。RAGによるナレッジベース連携、AI自動架電機能を搭載。ノーコードで導入可能。"
>
  <Fragment slot="structured-data">
    <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(productSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  </Fragment>

  <App client:load />
</BaseLayout>
