---
import '@fontsource-variable/noto-sans-jp'
import '../styles/index.css'

// Hero 領域で使用するフォントサブセットを preload するため、ビルド後のパスを取得
// ?url サフィックスで Vite が処理済みの URL を返す
import fontLatin from '@fontsource-variable/noto-sans-jp/files/noto-sans-jp-latin-wght-normal.woff2?url'
import fontJp114 from '@fontsource-variable/noto-sans-jp/files/noto-sans-jp-114-wght-normal.woff2?url'
import fontJp115 from '@fontsource-variable/noto-sans-jp/files/noto-sans-jp-115-wght-normal.woff2?url'
import fontJp116 from '@fontsource-variable/noto-sans-jp/files/noto-sans-jp-116-wght-normal.woff2?url'
import fontJp117 from '@fontsource-variable/noto-sans-jp/files/noto-sans-jp-117-wght-normal.woff2?url'
import fontJp119 from '@fontsource-variable/noto-sans-jp/files/noto-sans-jp-119-wght-normal.woff2?url'

interface Props {
  title: string
  description: string
  canonicalUrl?: string
  ogImage?: string
}

const {
  title,
  description,
  canonicalUrl = 'https://swarrow.com/',
  ogImage = 'https://swarrow.com/og-image.png',
} = Astro.props

const preloadFonts = [fontLatin, fontJp114, fontJp115, fontJp116, fontJp117, fontJp119]
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Font preload: Hero 領域の描画に必要なサブセットを先読み -->
    {preloadFonts.map((href) => (
      <link rel="preload" as="font" type="font/woff2" crossorigin href={href} />
    ))}

    <!-- SEO -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content="SwarrowCall" />
    <meta property="og:locale" content="ja_JP" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Structured Data -->
    <slot name="structured-data" />

    <slot name="head" />
  </head>
  <body>
    <slot />
  </body>
</html>
